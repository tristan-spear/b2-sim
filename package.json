{
  "name": "spirit-flight-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/visual-check.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html README.md",
    "test:combat": "node scripts/visual-check.mjs --combat",
    "test:fighter": "node scripts/visual-check.mjs --fighter",
    "test:lifecycle": "node scripts/visual-check.mjs --lifecycle",
    "test:campaign": "node scripts/visual-check.mjs --campaign --campaign-smoke",
    "test:campaign-play": "node scripts/visual-check.mjs --campaign --campaign-play",
    "test:campaign-lifecycle": "node scripts/visual-check.mjs --campaign --campaign-lifecycle",
    "test:campaign-boss": "node scripts/visual-check.mjs --campaign --campaign-boss"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
